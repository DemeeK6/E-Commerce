# Copy this to .env in the repository root on the server and fill every value.
#   cp deploy/env.example .env
# .env is in .gitignore - never commit it.

# Your domain, already pointing at the server's IP address.
DOMAIN=shop.example.com

# Database password. Make it long and random:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 characters:  openssl rand -hex 32
JWT_KEY=

# The admin account created on first start. Use a strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gmail sending (optional - leave empty and emails are only logged).
# EMAIL_APP_PASSWORD is the 16-character Google App Password, not your Gmail password.
EMAIL_FROM=
EMAIL_APP_PASSWORD=
EMAIL_ADMIN=
